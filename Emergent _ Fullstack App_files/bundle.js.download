___CSS_LOADER_EXPORT___.push([module.id, `body {
  margin: 0;
  font-family: 'Plus Jakarta Sans', sans-serif;
  background: #090d16;
}

.font-heading { font-family: 'Outfit', sans-serif; }
.font-mono { font-family: 'JetBrains Mono', monospace; }

@keyframes pinPulse {
  0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0.5; }
  100% { transform: translate(-50%, -50%) scale(2.2); opacity: 0; }
}

.qmap-pin { background: transparent; border: none; }

/* Leaflet dark popup */
.leaflet-popup-content-wrapper {
  background: #ffffff;
  border-radius: 10px;
  box-shadow: 0 8px 24px rgba(0,0,0,.4);
}
.leaflet-popup-tip { background: #ffffff; }
.leaflet-container { background: #0b0f19; font-family: 'Plus Jakarta Sans', sans-serif; }
.leaflet-tile-pane {
  filter: invert(1) hue-rotate(180deg) brightness(0.95) contrast(0.9);
}
.leaflet-control-zoom a {
  background: #111827 !important;
  color: #e5e7eb !important;
  border-color: #374151 !important;
}
.leaflet-control-zoom a:hover { background: #1f2937 !important; }
.leaflet-control-attribution {
  background: rgba(9,13,22,.8) !important;
  color: #6b7280 !important;
}
.leaflet-control-attribution a { color: #9ca3af !important; }

/* Scrollbar */
::-webkit-scrollbar { width: 8px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: #374151; }
